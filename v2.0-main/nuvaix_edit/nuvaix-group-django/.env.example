# Generate a strong secret before deployment: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
# Optional path to SQLite database; for production, configure DATABASES for managed PostgreSQL.
DATABASE_NAME=

# ---------------- Enquiry delivery ----------------
# Public WhatsApp number (digits only, with country code) for the "Chat with us" button
WHATSAPP_NUMBER=2349132165565
WHATSAPP_DISPLAY=+234 913 216 5565
# Group invite link. Shown to customers only if WHATSAPP_GROUP_PUBLIC=1 (below).
WHATSAPP_GROUP_INVITE_URL=https://chat.whatsapp.com/CkOMYcFNLrLGcJRXezDnjE
# FREE mode (no gateway): 1 = after submitting, send customers to the group link with their message copied to paste.
WHATSAPP_GROUP_PUBLIC=1
# Group relay via a WhatsApp gateway (see README "WhatsApp group relay"). Leave empty to disable.
WHATSAPP_GATEWAY_URL=https://gate.whapi.cloud/messages/text
WHATSAPP_GATEWAY_TOKEN=
WHATSAPP_GROUP_ID=
# Where "send via email" enquiries are delivered (Reply-To is the customer)
NUVAIX_EMAIL=info@yourdomain.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=
# Max enquiries per visitor IP per hour
ENQUIRY_RATE_LIMIT=8

# ---------------- Android app (Google Play) ----------------
# Fill in once the app is published. Empty => buttons show "Coming soon".
ANDROID_APP_PACKAGE=
PLAY_STORE_URL=
# Optional per-division apps (slug upper-cased, "-" -> "_"):
# PLAY_STORE_URL_PAINT=
# PLAY_STORE_URL_TECHNOLOGY=
# PLAY_STORE_URL_TECHNOLOGY_IT_SOLUTIONS=
# PLAY_STORE_URL_REAL_ESTATE=
# PLAY_STORE_URL_HEALTHCARE=
